rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to validate document ID format
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fedinheiroedestino@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Public Posts Collection
    match /posts/{postId} {
      // Anyone can read blog reviews and guides
      allow read: if true;
      // Public clients must never mutate editorial content.
      allow write: if isAuthorizedAdmin() && isValidId(postId);
    }

    // Global Settings Collection
    match /settings/{settingId} {
      // Public settings (AdSense, Affiliates) can be read
      allow read: if true;
      // Settings are read-only from the public client. Mutations belong in a
      // server-side Admin SDK/Cloud Function with an authenticated owner claim.
      allow write: if isAuthorizedAdmin() && settingId == 'global';
    }

    // Newsletter Subscribers (PII protected)
    match /newsletter/{subscriberId} {
      allow read: if false; // PII protection: subscribers list is private
      allow create: if false;
      allow update, delete: if false;
    }
  }
}
